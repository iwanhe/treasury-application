generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus { ACTIVE INACTIVE }
enum UserStatus { ACTIVE INACTIVE LOCKED }
enum TicketStatus { DRAFT SUBMITTED IN_REVIEW APPROVED REJECTED RETURNED IN_PROGRESS COMPLETED CANCELLED }
enum TicketPriority { LOW NORMAL HIGH URGENT }
enum RequestType { BANK_ACCOUNT_OPEN BANK_ACCOUNT_CLOSE INTERNET_BANKING FINANCIAL_INVESTMENT FX_DEAL FUNDING_LOAN FACILITY_EXTENSION OTHER }
enum ApprovalDecision { PENDING APPROVED REJECTED RETURNED }
enum AuditAction { CREATE UPDATE SUBMIT APPROVE REJECT RETURN CANCEL LOGIN LOGOUT EXPORT UPLOAD }

model Company {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(30)
  name        String @db.VarChar(200)
  legalName   String? @db.VarChar(250)
  status      CompanyStatus @default(ACTIVE)
  memberships UserCompanyRole[]
  tickets     TreasuryTicket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, name])
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(254)
  fullName     String @db.VarChar(160)
  status       UserStatus @default(ACTIVE)
  externalId   String? @unique @db.VarChar(160)
  memberships  UserCompanyRole[]
  requested    TreasuryTicket[] @relation("TicketRequester")
  assigned     TreasuryTicket[] @relation("TicketAssignee")
  approvalTasks TicketApproval[]
  auditEvents  AuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(50)
  name        String @db.VarChar(100)
  description String? @db.Text
  memberships UserCompanyRole[]
  createdAt   DateTime @default(now())
}

model UserCompanyRole {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  companyId String @db.Uuid
  roleId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([userId, companyId, roleId])
  @@index([companyId, roleId])
  @@index([userId, companyId])
}

model TreasuryTicket {
  id           String @id @default(uuid()) @db.Uuid
  ticketNo     String @unique @db.VarChar(40)
  companyId    String @db.Uuid
  requesterId  String @db.Uuid
  assigneeId   String? @db.Uuid
  type         RequestType
  title        String @db.VarChar(200)
  description  String @db.Text
  status       TicketStatus @default(DRAFT)
  priority     TicketPriority @default(NORMAL)
  submittedAt  DateTime?
  dueAt        DateTime?
  completedAt  DateTime?
  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requester    User @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee     User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approvals    TicketApproval[]
  attachments  TicketAttachment[]
  auditEvents  AuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([companyId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([assigneeId, status])
  @@index([dueAt, status])
}

model ApprovalRule {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String? @db.Uuid
  requestType RequestType
  sequence    Int
  approverRoleCode String @db.VarChar(50)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([companyId, requestType, isActive, sequence])
}

model TicketApproval {
  id          String @id @default(uuid()) @db.Uuid
  ticketId    String @db.Uuid
  sequence    Int
  approverId  String? @db.Uuid
  roleCode    String @db.VarChar(50)
  decision    ApprovalDecision @default(PENDING)
  comments    String? @db.Text
  decidedAt   DateTime?
  ticket      TreasuryTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approver    User? @relation(fields: [approverId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  @@unique([ticketId, sequence])
  @@index([approverId, decision])
}

model TicketAttachment {
  id           String @id @default(uuid()) @db.Uuid
  ticketId     String @db.Uuid
  originalName String @db.VarChar(255)
  storageKey   String @unique @db.VarChar(500)
  contentType  String @db.VarChar(150)
  sizeBytes    BigInt
  uploadedBy   String @db.Uuid
  createdAt    DateTime @default(now())
  ticket       TreasuryTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model AuditLog {
  id          String @id @default(uuid()) @db.Uuid
  actorId     String? @db.Uuid
  ticketId    String? @db.Uuid
  companyCode String? @db.VarChar(30)
  action      AuditAction
  entityType  String @db.VarChar(80)
  entityId    String? @db.VarChar(80)
  beforeData  Json?
  afterData   Json?
  ipAddress   String? @db.VarChar(45)
  userAgent   String? @db.VarChar(500)
  createdAt   DateTime @default(now())
  actor       User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ticket      TreasuryTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  @@index([companyCode, createdAt])
  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
}
