# Copy to .env on the OCI VM. chmod 600 .env. Never commit real values.
API_HOST=api.example.com
AUTH_HOST=auth.example.com
WEB_ORIGIN=https://your-site.netlify.app

# Neon direct connection string for the Treasury app database; require TLS.
TREASURY_DATABASE_URL=postgresql://treasury_user:URL_ENCODED_PASSWORD@YOUR_NEON_HOST/treasury_staging?sslmode=require&schema=public

# Separate Neon database and role for Keycloak.
KEYCLOAK_JDBC_URL=jdbc:postgresql://YOUR_NEON_HOST:5432/keycloak_staging?sslmode=require
KEYCLOAK_DB_USERNAME=keycloak_user
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

KEYCLOAK_ADMIN=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
